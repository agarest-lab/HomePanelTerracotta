[31m-[m
[31m-// Giorno + Notte, ridotte, subito dopo l'icona[m
[31m-dayNightRow.create([m
[31m-    lv_screen_active(),[m
[31m-    239,     // 227 + 12 di gap[m
[31m-    <Y>,     // <-- stessa Y di sopra[m
[31m-    227,     // larghezza di CIASCUNA delle due card (Giorno e Notte)[m
[31m-    180      // <-- stessa altezza di sopra[m
[31m-);[m
[31m-[m
